# API Keys (copy this to .env and fill in your keys)

# OpenRouter API Key — REQUIRED for live AI decisions (ai_client.py:214,494).
# Without it cron_runner.py fails its preflight and the legacy game loop fails
# when VisionClient initializes; neither entry point automatically uses a stub.
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# DeepSeek API Key — fallback provider (ai_client.py:532, cron_runner.py:760).
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional: Custom paths
# POKEMON_ROM_PATH=data/rom/Pokemon - Blue Version (USA, Europe) (SGB Enhanced).gb
# MEMORY_STORAGE_PATH=memory/
# LOG_PATH=logs/
