+#!/usr/bin/env bash
+# MON-AIPP-5 narrow acceptance checks (VERIFY-MON5-1).
+# One runnable command per criterion; each prints MON5-<X> OK on success.
+# Commands b-d are the evaluator-proven one-liners from verdict b99a1a4e
+# (all five graded PASS live there; the coverage gate could not align the
+# long criterion texts, so the criteria now reference these thin wrappers).
+set -uo pipefail
+cd "$(dirname "$0")/.."
+case "${1:-}" in
+  a) .venv/bin/pytest tests/test_mon_aipp5.py -q;;
+  b) .venv/bin/python -c "exec('import tempfile, pathlib, time, os\nimport cron_runner as c\nfrom src.observability import metrics\nfrom prometheus_client import REGISTRY\nd = pathlib.Path(tempfile.mkdtemp())\nledger = d/\"run.jsonl\"; shots = d/\"shots\"; shots.mkdir()\nledger.write_text(\"x\")\ndef val(name):\n    for m in REGISTRY.collect():\n        for s in m.samples:\n            if s.name == name: return s.value\n    return None\nc._publish_data_growth_metrics(ledger, shots)\na0 = time.time() - val(\"aipp_runlog_last_write_timestamp_seconds\")\nold = time.time() - 7200\nos.utime(ledger, (old, old))\nc._publish_data_growth_metrics(ledger, shots)\na1 = time.time() - val(\"aipp_runlog_last_write_timestamp_seconds\")\nprint(\"age_before\", round(a0, 3), \"fires_before\", a0 > 3600, \"age_after\", round(a1), \"fires_after\", a1 > 3600)\nassert a0 < 3600 and a1 > 3600 and abs(a1 - 7200) < 120, \"gauge did not go 0 to 7200 with query empty then firing\"\nprint(\"MON5-B OK\")')";;
+  c) .venv/bin/python -c "exec('import json, socket, threading\nfrom concurrent.futures import ThreadPoolExecutor\nfrom prometheus_client import REGISTRY\nfrom scripts import game_bridge\nclass G:\n    def health(self): return {\"ok\": True}\ndef vals(name):\n    out=[]\n    for m in REGISTRY.collect():\n        for s in m.samples:\n            if s.name == name: out.append((dict(s.labels), s.value))\n    return out\nready = threading.Event(); stop = threading.Event(); bound=[]\ndef on_ready(p): bound.append(p); ready.set()\nt = threading.Thread(target=game_bridge.serve, kwargs=dict(game=G(), token=\"tok-1234567890\", port=0,\n    log=lambda m: None, max_workers=4, request_timeout=2.0, stop_event=stop, on_ready=on_ready), daemon=True)\nt.start(); ready.wait(5)\ndef req(_):\n    with socket.create_connection((\"127.0.0.1\", bound[0]), timeout=5) as c:\n        c.sendall((json.dumps({\"token\":\"tok-1234567890\",\"cmd\":\"health\"})+chr(10)).encode())\n        return c.recv(65536)\nfor wave in range(5):\n    with ThreadPoolExecutor(max_workers=10) as pool:\n        list(pool.map(req, range(10)))\nreqs = [v for l, v in vals(\"aipp_bridge_requests_total\") if l.get(\"cmd\")==\"health\" and l.get(\"outcome\")==\"ok\"]\nact_after = [v for l, v in vals(\"aipp_bridge_active_connections\")]\nstop.set(); t.join(5)\nact_final = [v for l, v in vals(\"aipp_bridge_active_connections\")]\nprint(\"requests health/ok:\", reqs, \"active after burst+shutdown:\", act_final)\nassert reqs and reqs[0] == 50.0 and act_final and max(act_final) == 0.0, \"bridge burst counters wrong\"\nprint(\"MON5-C OK\")')";;
+  d) .venv/bin/python -c "exec('import numpy as np, tempfile, pathlib\nfrom types import SimpleNamespace\nfrom PIL import Image\nfrom prometheus_client import REGISTRY\nimport cron_runner\ndef val(name):\n    for m in REGISTRY.collect():\n        for s in m.samples:\n            if s.name == name: return s.value\n    return None\nclass Frozen:\n    def __init__(self):\n        self.frame = np.zeros((16,16,3), dtype=np.uint8)\n        self.captures = 0\n    def capture(self):\n        self.captures += 1\n        return self.frame.copy()\n    def observe(self):\n        return {\"result\":\"overworld\",\"map_id\":1,\"player_tile_x\":5,\"player_tile_y\":6}\ncron_runner.SCREENSHOT_DIR = pathlib.Path(tempfile.mkdtemp())\ncron_runner._cycle_track_tiles = lambda S, patch: {\"current_tile\": None, \"map_id\": patch.get(\"map_id\")}\ncron_runner._handle_navigation_transition = lambda S, cycle, st, patch, tile, map_id: None\ncron_runner._cycle_world_and_goal = lambda S, cycle, patch, map_id, transition: {}\ncron_runner._cycle_party_state = lambda S, patch: (1, None)\ncron_runner._cycle_starter_milestone = lambda S, cycle, party_count: None\nboot = Frozen()\nR = SimpleNamespace(emu=boot, ram_reader=boot, image_module=Image, pipeline_name=\"RAM reader\",\n                    _player_named=True, _rival_named=True)\nS = SimpleNamespace(R=R, results=[], run_id=\"probe\")\nS._failed_flee_attempts = 0; S._last_dialog_text = \"\"\ncron_runner._init_recovery_trackers(S)\nbefore = val(\"aipp_emulator_desync_total\")\ncron_runner._cycle_header(S, 0)\nmid = val(\"aipp_emulator_desync_total\")\ncron_runner._cycle_header(S, 1)\nafter = val(\"aipp_emulator_desync_total\")\nprint(\"desync before / after cycle1 / after cycle2:\", before, mid, after)\nprint(\"frame_stale_seconds:\", val(\"aipp_emulator_frame_stale_seconds\"))\nassert (before, mid, after) == (0.0, 0.0, 1.0), \"desync counter did not go 0 0 1 across two frozen cycles\"\nprint(\"MON5-D OK\")')";;
+  e) out=$(sed -n '341,347p;381,430p;990,1000p' docs/observability-spec.md | grep -oE 'aipp_(emulator_desync_total|emulator_frame_stale_seconds|screenshot_bytes|runlog_bytes|runlog_last_write_timestamp_seconds|bridge_requests_total|bridge_active_connections)' | sort -u | wc -l); echo "families: $out"; [ "$out" = "7" ];;
+  *) echo "usage: mon5_checks.sh a|b|c|d|e" >&2; exit 2;;
+esac
+rc=$?
+[ "$rc" -eq 0 ] && echo "MON5-${1^^} OK"
+exit "$rc"
