+def _decode_char(b: int) -> str:
+    """Decode one Pokémon Gen 1 text byte."""
+    if 0x80 <= b <= 0x99:
+        return chr(ord("A") + (b - 0x80))
+    if 0xA0 <= b <= 0xB9:
+        return chr(ord("a") + (b - 0xA0))
+    if 0x00 <= b <= 0x09:
+        return str(b)
+    if b in _TEXT_SPECIAL:
